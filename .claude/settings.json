{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hook-on-model-edit.sh\"",
            "asyncRewake": true,
            "rewakeSummary": "Contact_List pytest failure",
            "statusMessage": "Running pytest in background…",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
