#!/usr/bin/env bash
# Run local-ci.sh before every push, so CI failures are caught here rather than
# minutes later in a GitHub email.
#
# Enable once per clone (it is NOT automatic — git ignores .githooks by default):
#     git config core.hooksPath .githooks
#
# Every push is secret-scanned first, whatever else happens (local-gate.md § 2.1).
#
# A documentation-only push (every changed file a *.md or under docs/ -- no check
# in scripts/gate.sh reads either) skips the gate only when the branch's last
# GitHub CI run on a push succeeded (local-gate.md § 7). A tag push always runs
# it: a release ships whatever the tree holds. Anything else runs it.
#
# Escape hatch for a genuine emergency:  SKIP_LOCAL_CI=1 git push
# It skips the gate only; the secret scan still runs. Use it knowing you are
# pushing untested code; the next CI email is on you.
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
Z40="0000000000000000000000000000000000000000"

# git gives the pushed refs on stdin once; both the scan and the gate need them.
input=$(cat)

# The machine-wide hook's scan where it exists, else gitleaks itself over each
# pushed range. With neither, refuse: an unscanned push is the one thing this
# hook may not wave through.
if [ -x "$HOME/.claude/githooks/pre-push" ]; then
    printf '%s\n' "$input" | "$HOME/.claude/githooks/pre-push" --secrets-only || exit 1
elif command -v gitleaks >/dev/null 2>&1; then
    while read -r _l local_sha _r remote_sha; do
        { [ -z "${local_sha:-}" ] || [ "$local_sha" = "$Z40" ]; } && continue
        if [ "$remote_sha" = "$Z40" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
        gitleaks git --no-banner --log-opts="$range" "$REPO_ROOT" || exit 1
    done <<<"$input"
else
    echo "pre-push: no secret scanner found (install gitleaks) -- push refused." >&2
    exit 1
fi

if [ "${SKIP_LOCAL_CI:-}" = "1" ]; then
    echo "pre-push: SKIP_LOCAL_CI=1 — skipping local CI. Pushing untested."
    exit 0
fi

# Collect every file changed by the commits being pushed. git feeds the hook
# "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
changed=""
pushed=""
branches=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "$Z40" ] && continue          # branch deletion — nothing to check
    pushed="$pushed $local_sha"
    case "$local_ref" in
        refs/tags/*) changed="RUN_ANYWAY"; break ;;   # a release is never docs-only
    esac
    branches="$branches ${remote_ref#refs/heads/}"
    if [ "$remote_sha" = "$Z40" ]; then
        # New branch: diff against origin/HEAD's tip if we know it, else the
        # commit's own parent. Falls back to running CI when neither resolves.
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
    else
        base="$remote_sha"
    fi
    if [ -z "$base" ]; then
        changed="RUN_ANYWAY"
        break
    fi
    # A failing `git diff` must not read as "nothing changed". It fails whenever
    # $base names a commit this repo does not have -- the remote is ahead, a
    # force-push, pruned objects -- and the discarded error left `changed`
    # whitespace-only, so the empty test below exited 0 and skipped local CI
    # entirely, indistinguishable from having nothing to push.
    if ! diff_out=$(git diff --name-only "$base" "$local_sha" 2>/dev/null); then
        changed="RUN_ANYWAY"
        break
    fi
    changed="$changed$diff_out"$'\n'
done <<<"$input"

# Nothing being pushed (e.g. already up to date) — let git get on with it.
if [ -z "${changed//[[:space:]]/}" ]; then
    exit 0
fi

if [ "$changed" != "RUN_ANYWAY" ]; then
    # Docs-only? Every non-empty line must be a .md file or live under docs/.
    code_files=$(printf '%s' "$changed" | grep -v '^[[:space:]]*$' \
                 | grep -vE '(\.md$|^docs/)' || true)
    if [ -z "$code_files" ]; then
        # § 7's other condition: the branch's last push CI run succeeded. Asked
        # per pushed branch, by the ref being pushed, never the checked-out one.
        # Any doubt -- no gh, no run, a failure -- runs the gate instead.
        last_green=1
        for b in $branches; do
            c=$(gh run list --branch "$b" --event push --limit 1 --json conclusion --jq '.[0].conclusion' 2>/dev/null) || c=""
            [ "$c" = "success" ] || { last_green=0; break; }
        done
        if [ "$last_green" -eq 1 ]; then
            echo "pre-push: documentation-only push, and the last CI run on$branches passed — skipping local CI."
            exit 0
        fi
        echo "pre-push: documentation-only push, but the last CI run on$branches did not pass (or could not be read) — running local CI."
    else
        echo "pre-push: code changed, running local CI:"
        printf '%s\n' "$code_files" | sed 's/^/    /' | head -20
    fi
fi

# local-ci.sh tests the WORKING TREE, but git pushes COMMITS. The two agree only
# when every pushed commit is HEAD and nothing is uncommitted; otherwise a green
# run says nothing about what is being pushed (CL-0078).
head_sha=$(git rev-parse HEAD)
for sha in $pushed; do
    if [ "$sha" != "$head_sha" ]; then
        echo "pre-push: pushing a commit that is not checked out (HEAD) -- local CI would test the wrong code." >&2
        echo "          Check it out and push from there, or: SKIP_LOCAL_CI=1 git push" >&2
        exit 1
    fi
done
if [ -n "$(git status --porcelain)" ]; then
    echo "pre-push: uncommitted changes in the working tree -- local CI would test them, not the commits being pushed." >&2
    echo "          Commit or stash them (git stash -u), then push again." >&2
    git status --short | head -10 | sed 's/^/    /' >&2
    exit 1
fi

# A tree that already passed a full local-ci.sh run needs no second run
# (local-gate.md § 7.1). Keyed on the tree, so any change to any file misses.
tree=$(git rev-parse "HEAD^{tree}")
record="$(git rev-parse --git-common-dir)/ants-gate-passed/$tree"
if [ -f "$record" ]; then
    echo "pre-push: tree $tree already passed a full local CI run (record: $record) — skipping."
    exit 0
fi

echo
if "$REPO_ROOT/local-ci.sh"; then
    echo "pre-push: local CI green — pushing."
    exit 0
fi

cat >&2 <<'MSG'

pre-push: LOCAL CI FAILED — push aborted.

Fix the failures above and try again. If you genuinely must push anyway:
    SKIP_LOCAL_CI=1 git push
MSG
exit 1
